{
  "inputs": [
    {
      "type": "promptString",
      "id": "rubiic-token",
      "description": "Rubiic API token (rubiic.com/account → API tokens)",
      "password": true
    }
  ],
  "servers": {
    "rubiic": {
      "type": "http",
      "url": "https://rubiic.com/api/mcp",
      "headers": { "Authorization": "Bearer ${input:rubiic-token}" }
    }
  }
}
